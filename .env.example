# ============================================================
# LLM primário (LiteLLM server com backend Ollama)
# ============================================================
LITELLM_API_BASE_URL="http://localhost:4000"
# Chave virtual de autenticação no LiteLLM server (substitua pelo seu valor)
LITELLM_API_KEY=sk-litellm-your-virtual-key-here
# Modelo primário
LITELLM_MODEL="glm-4.7-flash:q4_K_M"

# ============================================================
# LLM de fallback (OpenRouter)
# ============================================================
# Chave de API do OpenRouter (substitua pelo seu valor)
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
# Modelo usado quando o LiteLLM falha
OPENROUTER_FALLBACK_MODEL="nvidia/nemotron-3-nano-30b-a3b:nitro"
# URL base da API do OpenRouter (opcional, padrão abaixo)
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ============================================================
# Demais configurações
# ============================================================
MODERATION_ENABLED=true

# ============================================================
# Variáveis DEPRECADAS (remova após migrar)
# ============================================================
# As variáveis antigas abaixo foram substituídas:
#   LLM_MODEL              -> LITELLM_MODEL
#   OPENROUTER_BASE_URL    -> LITELLM_API_BASE_URL (para o provedor primário;
#                             agora OPENROUTER_BASE_URL é usada apenas no fallback)
#
# Caminho de migração:
#   1. Defina LITELLM_API_BASE_URL, LITELLM_API_KEY e LITELLM_MODEL.
#   2. Defina OPENROUTER_API_KEY e OPENROUTER_FALLBACK_MODEL para o fallback.
#   3. Reinicie a aplicação e teste o fluxo principal e o fallback.
#   4. Remova as variáveis antigas do seu .env.
