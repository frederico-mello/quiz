    {
      "id": "claim_9a3627715e214ad3b2d9b63066acb404",
      "statement": "LLM evaluation uses a two-tier provider architecture: a LiteLLM server (with Ollama backend) is the primary provider, and OpenRouter is the automatic fallback when the primary fails; if both fail evaluate_answer raises a RuntimeError describing both errors.",
      "evidence": [
        {
          "resource": "repo://src/config.py#L10-L16",
          "version": "repo-lines-v1:sha256:c76256f5efb52fa41f71e3f2aa02000fc0d4a293aaa6a474fd625b43fdc170de:"
