    {
      "id": "claim_3684ba6de2c24f8c97d98cbbb7467af6",
      "statement": "LLM responses are cleaned for TTS by clean_text_for_tts, which strips markdown emphasis/headers and link syntax and normalizes whitespace before the text is spoken.",
      "evidence": [
        {
          "resource": "repo://src/llm_service.py#L77-L83",
