        }
      ]
    },
    {
      "id": "claim_9bcf31eed6fe4e92871fcad1b04fee87",
      "statement": "Both LLM providers are constructed with LangChain ChatOpenAI, the primary keyed by LITELLM_* env vars and the fallback by OPENROUTER_* env vars, both at temperature 0.7.",
      "evidence": [
        {
          "resource": "repo://src/llm_service.py#L20-L37",
