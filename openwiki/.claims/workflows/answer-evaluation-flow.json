    {
      "id": "claim_49f7c83e5d5541c3b8817b4f6d7a353c",
      "statement": "generate_speech removes the temp file and raises RuntimeError('Falha ao gerar áudio TTS: ...') on any synthesis exception; this RuntimeError is caught by the same _process_answer catch and surfaced as st.error.",
      "evidence": [
        {
          "resource": "repo://app.py#L167-L168",
