    {
      "id": "claim_36d90868e1434f8fb7a63ee7d8e13757",
      "statement": "get_warning_level maps the violation count deterministically: 0 to 'none', 1 to 'first', 2 to 'second', and 3 or more to 'blocked'; because the handler increments before the lookup, the first block yields 'first', the second 'second', and the third 'blocked'.",
