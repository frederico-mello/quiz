    {
      "id": "claim_23fce5071a7244e99ba1fd590169b06c",
      "statement": "check_text is the single public entry point for moderation and returns a (blocked, message) tuple; when the local check blocks, it returns immediately and never invokes the LLM.",
      "evidence": [
        {
          "resource": "repo://src/content_filter.py#L197-L215",
          "version": "repo-lines-v1:sha256:f8d431db34a8495f426ace90185ff7e0f9b46ca86b6e1c4ffec8a8bea3f188cb:"
        }
      ]
    },
    {
      "id": "claim_3770dcd38a204047b6166c7dc3ae24c3",
      "statement": "check_text runs a layered order: check_text_local (keywords then patterns) is the primary defense and runs first; check_text_llm runs only when use_llm=True and the local check passed, and is best-effort.",
      "evidence": [
        {
          "resource": "repo://src/content_filter.py#L158-L166",
