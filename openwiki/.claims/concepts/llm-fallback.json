    {
      "id": "claim_747beb8c733a4d14a61ff9e733632352",
      "statement": "evaluate_answer builds the prompt once via build_prompt, invokes the primary LiteLLM ChatOpenAI first, and on any exception from llm.invoke it logs a warning naming the failed LITELLM_MODEL before invoking the OpenRouter fallback; the same prompt_text is passed to whichever provider runs.",
      "evidence": [
        {
          "resource": "repo://src/llm_service.py#L86-L105",
