    {
      "id": "claim_9016a2c0d83b4c33b62dca6ccda99376",
      "statement": "clean_text_for_tts strips markdown emphasis/heading/inline-code markers (* # _ ~ and backticks), converts markdown links [text](url) to just the link text, collapses runs of two or more newlines into a single '. ', replaces remaining single newlines with spaces, and collapses all whitespace runs to a single space before stripping; the output is a flat, speakable string handed to edge-tts.",
      "evidence": [
