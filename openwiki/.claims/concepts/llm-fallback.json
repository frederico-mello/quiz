    {
      "id": "claim_deeb29f06d5349a19b2272c0a86a78d2",
      "statement": "When both providers raise, evaluate_answer raises a RuntimeError whose message begins with 'Falha total na avaliação por LLM: ambos os provedores falharam.' and embeds both the primary error (naming LITELLM_MODEL) and the fallback error (naming OPENROUTER_FALLBACK_MODEL); the exception is raised from the fallback exception, preserving the fallback traceback as the cause.",
      "evidence": [
        {
          "resource": "repo://openspec/specs/llm-fallback/spec.md#L20-L22",
