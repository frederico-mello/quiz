    {
      "id": "claim_2431cad6929e4b2d8322fbc6c845632c",
      "statement": "On any primary exception, evaluate_answer falls back to get_openrouter_fallback_llm() and invokes it; if the fallback succeeds its response.content is passed through clean_text_for_tts and returned, so a primary failure is transparent to the caller aside from the logged warning.",
      "evidence": [
        {
          "resource": "repo://openspec/specs/llm-fallback/spec.md#L11-L18",
