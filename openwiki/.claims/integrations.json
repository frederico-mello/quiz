  "claims": [
    {
      "id": "claim_48d0ebac39ee4b358c822b36ce9ae20a",
      "statement": "The app depends on two LLM endpoints via LangChain ChatOpenAI: a primary LiteLLM server (Ollama backend) and a fallback OpenRouter endpoint; both are OpenAI-compatible HTTP APIs so the same ChatOpenAI client is reused for both, differing only in base_url, model, and api_key.",
      "evidence": [
        {
          "resource": "repo://src/llm_service.py#L20-L37",
          "version": "repo-lines-v1:sha256:625750c8da0c1d8d2982c67575acf834ee2b92d79e839b66aa524f7e41645c8c:"
        }
      ]
    },
    {
      "id": "claim_091a3dcf66db46e4be64e6b74bf7b28d",
      "statement": "get_litellm_llm() constructs the primary ChatOpenAI at LITELLM_API_BASE_URL using LITELLM_MODEL and LITELLM_API_KEY (SecretStr-wrapped) at temperature 0.7.",
      "evidence": [
        {
          "resource": "repo://src/llm_service.py#L20-L27",
          "version": "repo-lines-v1:sha256:52d3df44c397fb26db50f2d3dd0a7ae7bccf52e7c4c23f1c899a023d85235fed:"
        }
      ]
    },
    {
      "id": "claim_ea4e6878106b4a04915b8447aac75b45",
      "statement": "get_openrouter_fallback_llm() constructs the fallback ChatOpenAI at OPENROUTER_BASE_URL (default https://openrouter.ai/api/v1) using OPENROUTER_FALLBACK_MODEL and OPENROUTER_API_KEY (SecretStr-wrapped) at temperature 0.7.",
      "evidence": [
        {
          "resource": "repo://src/config.py#L46-L50",
